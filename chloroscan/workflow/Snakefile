rule check_done:
    input:
        rules.check_binny_output.output.check_flag,
        rules.cds_extraction.output,
        CAT_OUTPUTS
    log:
        OUTPUT_DIR/"logging_info/check_done.log"
    output:
        OUTPUT_DIR/"ChloroScan.done"
    shell:
        """
        # check if all files are present, if yes, then touch the done file.
        flag=0
        for f in {input:q}; do
            if [ ! -s "$f" ]; then
                flag=1
                break
            fi
        done

        echo "Flag is $flag" >> {log}

        if [ $flag -eq 0 ]; then
            touch {output:q}
        fi
        """
